{
  "$description": "figma_sync fixture: primitives, semantic, semantic-dark.",
  "color": {
    "$type": "color",
    "gray": {
      "00": { "$value": "#FFFFFF" },
      "900": { "$value": "#111827" }
    },
    "accent": {
      "600": { "$value": "#7C3AED" }
    },
    "scrim": { "$value": "rgba(17, 24, 39, 0.4)" }
  },
  "space": {
    "$type": "dimension",
    "4": { "$value": { "value": 4, "unit": "px" } },
    "8": { "$value": "0.5rem" }
  },
  "radius": {
    "$type": "dimension",
    "md": { "$value": 8 }
  },
  "font": {
    "family": { "sans": { "$type": "fontFamily", "$value": ["Geist", "system-ui", "sans-serif"] } },
    "weight": { "semibold": { "$type": "fontWeight", "$value": 600 } }
  },
  "duration": {
    "$type": "duration",
    "fast": { "$value": { "value": 120, "unit": "ms" } }
  },
  "typography": {
    "$type": "typography",
    "body": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "14px" } }
  },
  "semantic": {
    "surface": {
      "default": { "$value": "{color.gray.00}", "$description": "cards" }
    },
    "text": {
      "primary": { "$value": "{color.gray.900}" }
    },
    "border": {
      "focus": { "$value": "{color.accent.600}" }
    },
    "space": {
      "inline": { "$value": "{space.8}" }
    }
  },
  "semantic-dark": {
    "surface": {
      "default": { "$value": "{color.gray.900}" }
    },
    "text": {
      "primary": { "$value": "{color.gray.00}" }
    }
  }
}
